# Variables de entorno — seguimiento-operaciones
# Copia este archivo a .env y llena los valores reales.

# PostgreSQL
POSTGRES_DB=seguimiento_operaciones
POSTGRES_USER=seguimiento
POSTGRES_PASSWORD=generar_con: openssl rand -hex 24

# Conexión de la aplicación (dentro de la red Docker)
DATABASE_URL=postgres://seguimiento:${POSTGRES_PASSWORD}@postgres:5432/seguimiento_operaciones

# MinIO (S3 compatible)
S3_ACCESS_KEY=seguimiento
S3_SECRET_KEY=generar_con: openssl rand -hex 24
MINIO_ENDPOINT=minio:9000
S3_BUCKET=seguimiento-archivos
S3_FORCE_PATH_STYLE=true

# Aplicación web (Next.js)
# OAuth de Google para operación real; en desarrollo se usa auth local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTHORIZED_DOMAINS=
SESSION_SECRET=generar_con: openssl rand -hex 32
APP_BASE_URL=http://localhost:8080

# Reconocimiento facial de WhatsApp: escaneo cada 6 h y actualización diaria.
FACE_SCAN_INTERVAL_MS=21600000
FACE_TRAIN_INTERVAL_MS=86400000
FACE_SCAN_ENABLED=true
FACE_SFACE_ENABLED=true
FACE_SFACE_BATCH_SIZE=250
FACE_SFACE_THRESHOLD=0.363
FACE_SFACE_MARGIN=0.05

# Acceso remoto por Tailscale: IP de la máquina en la red (tailscale ip -4).
# La web queda también disponible en http://<TAILSCALE_IP>:8080
TAILSCALE_IP=

# Horarios y zonas
DEFAULT_TIMEZONE=America/Mexico_City

# Worker de alertas (Fase 5): token compartido entre worker y web.
WORKER_TOKEN=generar_con: openssl rand -hex 24

# Correo (Fase 5). En desarrollo local usar el contenedor Mailpit:
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_SECURE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Seguimiento Ops <seguimiento@localhost>

# WhatsApp (Fase 5). Déjalo vacío para mantener el canal apagado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Análisis de fotos con Ollama. Déjalo vacío hasta que el contenedor web pueda
# alcanzar de forma segura la API local de Ollama.
OLLAMA_BASE_URL=
OLLAMA_MODEL=frob/qwen3.5-instruct:9b
EXPENSE_PHOTO_SCAN_ENABLED=true
EXPENSE_PHOTO_SCAN_HOUR=1
